# انسخ إلى .env محليًا أو أضف القيم في Vercel → Settings → Environment Variables
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# الحدود (اختيارية — لها الافتراضيات أدناه)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
